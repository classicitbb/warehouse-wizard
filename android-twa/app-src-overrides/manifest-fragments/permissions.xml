<!--
  Warehouse Wizard — manifest-level additions.

  This fragment is spliced into the Bubblewrap-generated AndroidManifest.xml
  by the CI workflow (.github/workflows/android-build-deploy.yml), inserted
  immediately after the opening <manifest ...> tag and before the existing
  <application> element. If merging by hand instead, paste this block in the
  same place.
-->

<!-- Required so BootReceiver can be woken on device restart. -->
<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

<!-- Required on Android 13+ (API 33) to show the update-available notification. -->
<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

<!-- Required to launch the system package installer for the downloaded APK. -->
<uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

<!-- Lets the update check skip the network call entirely when offline. -->
<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

<!-- Bubblewrap already declares INTERNET, kept here as documentation only:
<uses-permission android:name="android.permission.INTERNET" />
-->
