<?xml version="1.0" encoding="utf-8"?>
<!--
  Warehouse Wizard — additional string resources.

  Destination: android-twa/app-src-overrides/res/values/strings.xml
  Bubblewrap generates its own strings.xml (appName, launcherName, etc).
  CI merges these <string> entries into that file rather than overwriting
  it — do not remove Bubblewrap's existing entries when merging by hand.
-->
<resources>
    <!--
      Base URL where update-manifest.json and the signed APKs are hosted
      (the GitHub Pages folder published from /docs). Update this if you
      set a custom domain for Pages — see android-twa/README.md section 2.4.
    -->
    <string name="update_base_url" translatable="false">https://classicitbb.github.io/threeplmgmt/</string>

    <string name="update_channel_name">App updates</string>
    <string name="update_channel_description">Notifies you when a new version of Warehouse Wizard is ready to install.</string>
    <string name="update_notification_title">Update available</string>
    <string name="update_notification_text">A new version of Warehouse Wizard is ready. Tap to download.</string>
    <string name="update_downloading_title">Downloading update…</string>
    <string name="update_ready_title">Update ready to install</string>
    <string name="update_ready_text">Tap to finish installing the latest version.</string>
</resources>
