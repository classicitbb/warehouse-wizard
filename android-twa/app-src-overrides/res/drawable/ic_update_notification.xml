<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar notification icon (download-arrow glyph). Android requires
  status bar icons to be a flat white silhouette on transparent — the
  system tints it, so no brand color here (brand color comes from
  NotificationCompat.Builder#setColor in NotificationHelper).

  Destination: android-twa/app-src-overrides/res/drawable/ic_update_notification.xml
  Bundled here (rather than relying on a Bubblewrap-generated icon) so the
  notification works regardless of Bubblewrap version.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <path
        android:fillColor="#FF000000"
        android:pathData="M19,9h-4V3H9v6H5l7,7l7,-7zM5,18v2h14v-2H5z" />
</vector>
